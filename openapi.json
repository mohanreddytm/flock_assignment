    "/api/v1/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Read the available consumption window",
        "description": "start and end are inclusive ISO 8601 timestamps with timezone offsets. Filtering is local and does not request older history. Measurements are cumulative registers by assumption; interval_kwh is their difference.",
        "operationId": "consumption_api_v1_meters__meter_id__consumption_get",
        "security": [
          {
            "APIKeyHeader": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "description": "Portal meter identifier, for example J100000.",
              "title": "Meter Id"
            },
            "description": "Portal meter identifier, for example J100000."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Consumption"
                }
              }
            }
          },
          "401": {
            "description": "Invalid wrapper API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
